---
/**
 * Базовый layout: шрифты, токены, SEO-мета, hreflang, JSON-LD, шапка, подвал, курсор.
 */
import '@fontsource-variable/inter-tight/index.css';
import '@fontsource-variable/unbounded/index.css';
import '@fontsource-variable/jetbrains-mono/index.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/typography.css';

import interLatin from '@fontsource-variable/inter-tight/files/inter-tight-latin-wght-normal.woff2?url';
import interCyr from '@fontsource-variable/inter-tight/files/inter-tight-cyrillic-wght-normal.woff2?url';
import monoLatin from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getContent, type LangCode } from '../lib/i18n';
import { canonical, hreflangLinks, ogLocale, absolute, organizationLd, websiteLd } from '../lib/seo';
import { ANALYTICS } from '../../site.config';
import { withBase, PREVIEW } from '../lib/base';

export interface Props {
  lang: LangCode;
  path: string;
  title: string;
  description: string;
  theme?: 'black' | 'graphite' | 'steel' | 'blue' | 'silver';
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: unknown[];
  bodyClass?: string;
  /** Скрыть шапку/подвал (лаборатории) */
  bare?: boolean;
  /** Не показывать подвал (главная рисует свой) */
  noFooter?: boolean;
}

const {
  lang,
  path,
  title,
  description,
  theme = 'black',
  ogImage = '/posters/og-default.jpg',
  ogType = 'website',
  noindex = false,
  jsonLd = [],
  bodyClass = '',
  bare = false,
  noFooter = false,
} = Astro.props;

const content = getContent(lang);
const canonicalUrl = canonical(lang, path);
const alts = hreflangLinks(path);
const ld = [organizationLd(lang), websiteLd(lang), ...jsonLd];
const preloadCyr = lang === 'ru';
const analyticsOn = Boolean(ANALYTICS.ga4 || ANALYTICS.metaPixel || ANALYTICS.tiktokPixel);
---

<!doctype html>
<html lang={lang} data-theme={theme} class="no-js">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.remove('no-js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {(noindex || PREVIEW) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    {alts.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={content.ui.brand} />
    <meta property="og:locale" content={ogLocale(lang)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage.startsWith('http') ? ogImage : absolute(ogImage)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.startsWith('http') ? ogImage : absolute(ogImage)} />

    <link rel="icon" href={withBase('/favicon.ico')} sizes="48x48" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="manifest" href={withBase('/site.webmanifest')} />
    <meta name="theme-color" content="#050505" />
    <meta name="color-scheme" content="dark" />

    <link rel="preload" as="font" type="font/woff2" href={interLatin} crossorigin />
    {preloadCyr && <link rel="preload" as="font" type="font/woff2" href={interCyr} crossorigin />}
    <link rel="preload" as="font" type="font/woff2" href={monoLatin} crossorigin />

    {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
    <slot name="head" />
  </head>
  <body class:list={[bodyClass, { 'is-bare': bare }]} data-lang={lang} data-analytics={analyticsOn ? '1' : '0'}>
    <a class="skip-link" href="#main">{content.ui.skip}</a>

    <!-- SVG-фильтр для .chrome-text: тиснение со specular lighting, как в ref-01 -->
    <svg width="0" height="0" aria-hidden="true" focusable="false" style="position:absolute">
      <defs>
        <filter id="chrome-emboss" x="-10%" y="-20%" width="120%" height="140%" color-interpolation-filters="sRGB">
          <feGaussianBlur in="SourceAlpha" stdDeviation="1.2" result="blur" />
          <feSpecularLighting in="blur" surfaceScale="4" specularConstant="1.1" specularExponent="22" lighting-color="#ffffff" result="spec">
            <feDistantLight azimuth="235" elevation="38" />
          </feSpecularLighting>
          <feComposite in="spec" in2="SourceAlpha" operator="in" result="specIn" />
          <feComposite in="SourceGraphic" in2="specIn" operator="arithmetic" k1="0" k2="1" k3="0.9" k4="0" result="lit" />
          <feDropShadow dx="0" dy="0.6" stdDeviation="0.4" flood-color="#000" flood-opacity="0.45" />
        </filter>
      </defs>
    </svg>

    {!bare && <Header lang={lang} path={path} />}
    <main id="main">
      <slot />
    </main>
    {!bare && !noFooter && <Footer lang={lang} />}

    <div class="cursor" aria-hidden="true"><span class="cursor__ring"></span></div>
    <script>
      import { initSite } from '../lib/site';
      initSite();
    </script>
  </body>
</html>

<style is:global>
  .cursor {
    position: fixed;
    inset: 0;
    z-index: 900;
    pointer-events: none;
    display: none;
  }
  .cursor__ring {
    position: absolute;
    left: 0;
    top: 0;
    width: 22px;
    height: 22px;
    margin: -11px 0 0 -11px;
    border: 1px solid #fff;
    border-radius: 50%;
    mix-blend-mode: difference;
    transform: translate3d(-100px, -100px, 0) scale(1);
    transition: width 0.25s var(--ease-out), height 0.25s var(--ease-out), margin 0.25s var(--ease-out), opacity 0.3s;
    will-change: transform;
  }
  body.has-cursor .cursor {
    display: block;
  }
  body.has-cursor .cursor__ring.is-active {
    width: 48px;
    height: 48px;
    margin: -24px 0 0 -24px;
  }
  body.has-cursor .cursor__ring.is-hidden {
    opacity: 0;
  }
</style>
