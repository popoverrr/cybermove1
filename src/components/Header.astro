---
import Logo from './Logo.astro';
import Button from './Button.astro';
import { getContent, localePath, alternates, type LangCode } from '../lib/i18n';

export interface Props {
  lang: LangCode;
  path: string;
}
const { lang, path } = Astro.props;
const c = getContent(lang);
const alts = alternates(path);
const current = (href: string) => path !== '/' && href !== '/' && path.startsWith(href);
---

<header class="header" data-header>
  <div class="header__inner">
    <a class="header__logo" href={localePath(lang, '/')} aria-label={c.ui.brand}>
      <Logo height={26} />
    </a>

    <nav class="header__nav" aria-label={c.ui.menu}>
      <ul class="header__list">
        {c.ui.nav.map((item) => (
          <li>
            <a class="header__link" href={localePath(lang, item.href)} aria-current={current(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header__right">
      <div class="lang" role="group" aria-label={c.ui.langSwitch}>
        {alts.map((a) => (
          <a class="lang__link t-micro" href={a.href} aria-current={a.lang === lang ? 'true' : undefined} hreflang={a.hreflang} lang={a.lang}>
            {a.label}
          </a>
        ))}
      </div>
      <Button href={localePath(lang, '/contact/')} variant="ghost" size="sm" class="header__cta">
        {c.ui.ctaShort}
      </Button>
      <button class="burger" type="button" data-menu-toggle aria-expanded="false" aria-controls="mobile-menu" aria-label={c.ui.menu}>
        <span></span><span></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-menu aria-hidden="true">
    <div class="mobile-menu__inner">
      <ul class="mobile-menu__list">
        {c.ui.nav.map((item, i) => (
          <li>
            <a class="mobile-menu__link t-h2" href={localePath(lang, item.href)}>
              <span class="t-micro mobile-menu__idx">0{i + 1}</span>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <div class="mobile-menu__foot">
        <Button href={localePath(lang, '/contact/')} variant="fill" size="lg" magnetic={false}>
          {c.ui.cta}
        </Button>
        <div class="lang" role="group" aria-label={c.ui.langSwitch}>
          {alts.map((a) => (
            <a class="lang__link t-micro" href={a.href} aria-current={a.lang === lang ? 'true' : undefined}>
              {a.label}
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 800;
    height: var(--header-h);
    color: var(--fg);
    transition: transform var(--dur) var(--ease-out), background-color var(--dur) var(--ease-out);
  }
  .header::after {
    content: '';
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: 0;
    height: 1px;
    background: var(--hair);
    opacity: 0;
    transition: opacity var(--dur);
  }
  .header.is-scrolled::after {
    opacity: 1;
  }
  .header.is-hidden {
    transform: translateY(-100%);
  }
  .header__inner {
    height: 100%;
    max-width: var(--max-w);
    margin-inline: auto;
    padding-inline: var(--gutter);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-6);
  }
  .header__logo {
    display: inline-flex;
    justify-self: start;
  }
  .header__list {
    display: flex;
    gap: clamp(1.25rem, 2.4vw, 2.5rem);
  }
  .header__link {
    position: relative;
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: -0.005em;
    padding: 0.5rem 0;
    color: var(--fg-2);
    transition: color var(--dur-fast);
  }
  .header__link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0.15rem;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur) var(--ease-out);
  }
  .header__link:hover,
  .header__link[aria-current='page'] {
    color: var(--fg);
  }
  .header__link:hover::after,
  .header__link[aria-current='page']::after {
    transform: scaleX(1);
  }
  .header__right {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }
  .lang {
    display: inline-flex;
    gap: 0.75rem;
  }
  .lang__link {
    color: var(--fg-3);
    padding: 0.25rem 0;
    transition: color var(--dur-fast);
  }
  .lang__link:hover,
  .lang__link[aria-current='true'] {
    color: var(--fg);
  }
  .burger {
    display: none;
    width: 40px;
    height: 40px;
    position: relative;
    margin-right: -8px;
  }
  .burger span {
    position: absolute;
    left: 10px;
    width: 20px;
    height: 1px;
    background: currentColor;
    transition: transform var(--dur) var(--ease-out), top var(--dur) var(--ease-out);
  }
  .burger span:first-child {
    top: 16px;
  }
  .burger span:last-child {
    top: 23px;
  }
  :global(body.menu-open) .burger span:first-child {
    top: 20px;
    transform: rotate(45deg);
  }
  :global(body.menu-open) .burger span:last-child {
    top: 20px;
    transform: rotate(-45deg);
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: -1;
    background: var(--black);
    color: var(--white);
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--dur) var(--ease-out), visibility 0s linear var(--dur);
  }
  :global(body.menu-open) .mobile-menu {
    opacity: 1;
    visibility: visible;
    transition: opacity var(--dur) var(--ease-out);
  }
  .mobile-menu__inner {
    height: 100%;
    padding: calc(var(--header-h) + var(--space-8)) var(--gutter) var(--space-8);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .mobile-menu__list {
    display: grid;
    gap: var(--space-4);
  }
  .mobile-menu__link {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--hair);
    transform: translateY(20px);
    opacity: 0;
    transition: transform 0.7s var(--ease-out), opacity 0.7s var(--ease-out);
  }
  :global(body.menu-open) .mobile-menu__link {
    transform: none;
    opacity: 1;
  }
  :global(body.menu-open) .mobile-menu li:nth-child(2) .mobile-menu__link { transition-delay: 0.05s; }
  :global(body.menu-open) .mobile-menu li:nth-child(3) .mobile-menu__link { transition-delay: 0.1s; }
  :global(body.menu-open) .mobile-menu li:nth-child(4) .mobile-menu__link { transition-delay: 0.15s; }
  .mobile-menu__idx {
    color: var(--steel-600);
  }
  .mobile-menu__foot {
    display: grid;
    gap: var(--space-6);
  }

  @media (max-width: 1023px) {
    .header__inner {
      grid-template-columns: auto 1fr;
    }
    .header__nav {
      display: none;
    }
    .header__right .lang,
    .header__cta {
      display: none;
    }
    .burger {
      display: block;
    }
    :global(body.menu-open) {
      overflow: hidden;
    }
    :global(body.menu-open) .header {
      color: var(--white);
      transform: none !important;
    }
  }
</style>
