---
/** Прелоадер (волосяная линия и счётчик, ≤ 1.5 с) и кнопка звука (AudioToggle). */
import { getContent, type LangCode } from '../../lib/i18n';

export interface Props {
  lang: LangCode;
}
const { lang } = Astro.props;
const c = getContent(lang);
---

<div class="preloader" data-preloader aria-hidden="true">
  <div class="preloader__inner">
    <p class="preloader__brand t-micro">{c.ui.brand} · {c.ui.formula.join(' → ')}</p>
    <p class="preloader__count t-mono"><span data-preloader-count>00</span></p>
    <div class="preloader__line"><span data-preloader-bar></span></div>
  </div>
</div>


<style>
  .preloader {
    position: fixed;
    inset: 0;
    z-index: 950;
    background: var(--black);
    color: var(--white);
    display: grid;
    place-items: center;
    transition: opacity 0.6s var(--ease-out), visibility 0s linear 0.6s;
  }
  .preloader.is-done {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
  :global(html.no-js) .preloader {
    display: none;
  }
  .preloader__inner {
    display: grid;
    gap: var(--space-4);
    width: min(360px, 70vw);
  }
  .preloader__brand {
    color: var(--steel-600);
  }
  .preloader__count {
    font-size: 2.5rem;
    font-weight: 300;
    letter-spacing: -0.02em;
    color: var(--white);
    line-height: 1;
  }
  .preloader__line {
    height: 1px;
    background: rgba(244, 246, 250, 0.14);
    position: relative;
  }
  .preloader__line span {
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    width: 0%;
    background: var(--white);
    transition: width 0.12s linear;
  }

</style>
