{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@config": ["site.config.ts"]
    },
    "types": ["astro/client"],
    "resolveJsonModule": true,
    "allowJs": true,
    "noUncheckedIndexedAccess": false
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "node_modules"]
}
